[configuration]

entry_symbol = "robot_arena_init"
compatibility_minimum = "4.7"

[libraries]

macos.debug = "./macos/librobot_arena.macos.template_debug.dylib"
macos.release = "./macos/librobot_arena.macos.template_release.dylib"
windows.debug.x86_64 = "./windows/robot_arena.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./windows/robot_arena.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./linux/librobot_arena.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./linux/librobot_arena.linux.template_release.x86_64.so"
